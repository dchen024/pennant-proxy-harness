# OpenRouter: used for every LLM call AND for Voyage embeddings
OPENROUTER_API_KEY=

# MongoDB Atlas: Connect → Drivers → Node.js (fill in the password)
MONGODB_URI=
MONGODB_DB=pennant_harness

# SEC EDGAR requires a real contact in the User-Agent, e.g. "Jane Doe jane@example.com"
SEC_USER_AGENT=

# LangSmith tracing (optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pennant-proxy-harness

# Vercel Deployment
MONGODB_READONLY_USER=verceldeployment
MONGODB_READONLY_PASSWORD=