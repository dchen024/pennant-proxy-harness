{
  "name": "pennant-proxy-harness",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "filings": "tsx scripts/fetch-filings.ts",
    "ingest": "tsx scripts/ingest.ts",
    "harness": "tsx scripts/harness.ts",
    "gold:draft": "tsx scripts/draft-gold.ts",
    "gold:export": "tsx scripts/export-gold.ts",
    "gold:import": "tsx scripts/import-gold.ts",
    "copy:pdf-worker": "node -e \"require('fs').copyFileSync('node_modules/pdfjs-dist/build/pdf.worker.min.mjs','public/pdf.worker.min.mjs')\"",
    "postinstall": "pnpm run copy:pdf-worker",
    "pipeline": "pnpm filings && pnpm ingest && pnpm gold:draft",
    "test": "vitest run",
    "policy:compile": "tsx scripts/compile-policy.ts",
    "db:index": "tsx scripts/ensure-index.ts",
    "regrade": "tsx scripts/regrade.ts",
    "eval:retrieval": "tsx scripts/retrieval-eval.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "langsmith": "^0.10.5",
    "lucide-react": "^1.48.0",
    "mongodb": "^7.6.0",
    "next": "16.3.6",
    "openai": "^7.23.0",
    "p-limit": "^7.3.3",
    "pdfjs-dist": "6.3.289",
    "puppeteer-core": "^25.12.0",
    "radix-ui": "^1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-pdf": "^11.0.0",
    "shadcn": "^4.21.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20.19.43",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.2"
  },
  "packageManager": "pnpm@10.7.0"
}
